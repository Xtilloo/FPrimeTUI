/* F-Prime Mission Control - JPL/NASA Theme */

Screen {
    background: #121212;
    color: #F5F5F5;
    layout: vertical;
}

#chat-container {
    height: 1fr;
    background: #121212;
    overflow-y: scroll;
    padding: 1 2;
    scrollbar-color: #34495e;
    scrollbar-color-hover: #e67e22;
    scrollbar-color-active: #e67e22;
}

#input-area {
    dock: bottom;
    height: auto;
    margin: 0 1 1 1;
    border-top: solid #333333;
    background: #1a1a1a;
}

#input-container {
    height: auto;
    border: none;
    padding: 0;
}

#prompt-label {
    color: #e67e22;
    padding: 0 0 0 1;
    text-style: bold;
    width: auto;
    height: 3;
}

#ai-input {
    background: #1a1a1a;
    border: none;
    height: 5;
    padding: 0 1;
    color: #ffffff;
    width: 1fr;
}

#ai-input:focus {
    border: none;
}

#thinking-indicator {
    height: 1;
    color: #e67e22;
    margin: 0 1;
    display: none;
}

#autocomplete-list {
    background: #1a1a1a;
    border: solid #e67e22;
    height: 10;
    display: none;
    margin-bottom: 1;
}

/* Chat turn headers - Full width bars */
.chat-header {
    background: #1a1a1a;
    color: #e67e22;
    text-style: bold;
    padding: 0 1;
    margin-top: 1;
    border-bottom: solid #333333;
    width: 100%;
}

.user-prompt {
    padding: 0 2;
    color: #f5f5f5;
    margin-bottom: 1;
}

.ai-response {
    padding: 0 2;
    margin-bottom: 1;
    background: transparent;
}

.status-line {
    padding: 0 2;
    color: #e67e22;
    text-style: italic;
}

Markdown {
    background: transparent;
    padding: 0;
    margin: 0;
}

/* Prevent highlights when blocks are focused */
Markdown:focus, Markdown > *:focus, MarkdownBlock:focus {
    background: transparent;
    border: none;
}

MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 {
    color: #e67e22 !important;
    text-style: bold;
}

/* --- Code Blocks (User Fixed) --- */
MarkdownFence {
    background: #1a1a1a !important;
    border-left: solid #e67e22 !important;
    margin: 1 0;
    padding: 1 2;
    height: auto;
}

MarkdownFence:focus {
    background: #1a1a1a !important;
}

/* This targets the actual lines of code rendered inside the fence */
MarkdownFence > .markdown--code-block {
    background: transparent !important;
    color: #f5f5f5 !important;
}

/* This overrides the syntax highlighter's specific span colors */
MarkdownFence * {
    color: #f5f5f5 !important;
    background: transparent !important;
}

/* Inline code styling */
.markdown--code_inline, .markdown--inline-code {
    background: #3c3c3c !important;
    color: #e67e22 !important;
    text-style: bold;
}

/* Decorative elements */
MarkdownBlockQuote, MarkdownBullet, .markdown--strong, .markdown--em, .markdown--link {
    color: #e67e22 !important;
}

MarkdownBlockQuote {
    border-left: solid #e67e22 !important;
    background: #1a1a1a !important;
    margin: 1 0;
    padding: 0 1;
}

/* Utility Classes */
.generating #ai-input {
    opacity: 0.5;
}

.hide-scrollbars {
    scrollbar-size: 0 0;
}
