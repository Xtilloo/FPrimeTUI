#!/bin/bash
# Project launch script for F-Prime-TUI (Mission Control)

ORIGINAL_DIR=$(pwd)

# Ensure the script is run from the project root (handles symlinks)
if [[ -L "$0" ]]; then
    SCRIPT_PATH=$(readlink "$0")
else
    SCRIPT_PATH="$0"
fi
ROOT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
cd "$ROOT_DIR"

# Check if venv exists
if [ ! -d "venv" ]; then
    echo "❌ Error: Virtual environment (venv) not found. Run 'make install' first."
    exit 1
fi

# Run the TUI
export PYTHONPATH=./TUI
cd "$ORIGINAL_DIR"
exec "$ROOT_DIR/venv/bin/python3" "$ROOT_DIR/TUI/app.py"
